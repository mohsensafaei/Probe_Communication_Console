{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Probe sequence versions 1\u20133",
  "description": "Authoring contract. Probe also validates byte encodings, cross-field rules, totals and references before applying. Schemas do not execute or send anything.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "maxLength": 512
        },
        "format": {
          "const": "probe-sequence"
        },
        "version": {
          "enum": [
            1,
            2,
            3
          ]
        },
        "cycles": {
          "type": [
            "integer",
            "string"
          ],
          "minimum": 0,
          "maximum": 1000000,
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "variables": {
          "type": "object",
          "maxProperties": 64,
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]{0,47}$": {
              "type": "object",
              "properties": {
                "format": {
                  "enum": [
                    "Text",
                    "Hex",
                    "JSON"
                  ]
                },
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "minItems": 1,
          "maxItems": 1000
        }
      },
      "required": [
        "format",
        "version",
        "steps"
      ],
      "additionalProperties": false
    },
    {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      },
      "minItems": 1,
      "maxItems": 1000
    }
  ],
  "$defs": {
    "action": {
      "type": "object",
      "properties": {
        "action": {
          "enum": [
            "next",
            "goto",
            "stop",
            "fail"
          ]
        },
        "target": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "properties": {
        "step_id": {
          "type": "string",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "text": {
          "type": "string",
          "maxLength": 16777216
        },
        "send_mode": {
          "enum": [
            "Text",
            "Hex",
            "Escaped",
            "Decimal",
            "Hercules"
          ]
        },
        "encoding": {
          "type": "string",
          "maxLength": 64
        },
        "ending": {
          "enum": [
            "None",
            "LF",
            "CR",
            "CRLF"
          ]
        },
        "checksum": {
          "enum": [
            "None",
            "SUM8",
            "XOR8",
            "LRC8",
            "CRC16 Modbus",
            "CRC16 CCITT",
            "CRC32"
          ]
        },
        "prefix": {
          "type": "string",
          "maxLength": 65536
        },
        "suffix": {
          "type": "string",
          "maxLength": 65536
        },
        "length_prefix": {
          "type": [
            "integer",
            "string"
          ],
          "minimum": 0,
          "maximum": 12,
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "delay_ms": {
          "type": [
            "integer",
            "string"
          ],
          "minimum": 0,
          "maximum": 3600000,
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "repeat": {
          "type": [
            "integer",
            "string"
          ],
          "minimum": 1,
          "maximum": 1000000,
          "pattern": "^[1-9][0-9]*$"
        },
        "expect": {
          "type": "string",
          "maxLength": 262144
        },
        "timeout_ms": {
          "type": [
            "integer",
            "string"
          ],
          "minimum": 1,
          "maximum": 3600000,
          "pattern": "^[1-9][0-9]*$"
        },
        "wait_for_reply": {
          "type": "boolean"
        },
        "flow": {
          "type": "object",
          "properties": {
            "extract": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,47}$"
                  },
                  "source": {
                    "enum": [
                      "JSON",
                      "TLV",
                      "BER-TLV",
                      "Bytes"
                    ]
                  },
                  "selector": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "offset": {
                    "type": [
                      "integer",
                      "string"
                    ],
                    "minimum": 0,
                    "maximum": 1048576,
                    "pattern": "^(0|[1-9][0-9]*)$"
                  },
                  "length": {
                    "type": [
                      "integer",
                      "string"
                    ],
                    "minimum": 1,
                    "maximum": 65536,
                    "pattern": "^[1-9][0-9]*$"
                  },
                  "format": {
                    "enum": [
                      "Text",
                      "Hex",
                      "Unsigned LE",
                      "Unsigned BE"
                    ]
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              },
              "minItems": 0,
              "maxItems": 16
            },
            "condition": {
              "type": "object",
              "properties": {
                "variable": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,47}$"
                },
                "operator": {
                  "enum": [
                    "equals",
                    "not equals",
                    "contains",
                    "greater than",
                    "less than"
                  ]
                },
                "value": {
                  "type": "string",
                  "maxLength": 65536
                }
              },
              "required": [
                "variable"
              ],
              "additionalProperties": false
            },
            "on_true": {
              "$ref": "#/$defs/action"
            },
            "on_false": {
              "$ref": "#/$defs/action"
            },
            "on_timeout": {
              "$ref": "#/$defs/action"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "source_direction": {
          "enum": [
            "TX",
            "RX"
          ]
        },
        "source_peer": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    }
  }
}
