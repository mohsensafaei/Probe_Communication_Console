{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Probe protocol profile version 1",
  "description": "Authoring contract. Probe also validates byte encodings, cross-field rules, totals and references before applying. Schemas do not execute or send anything.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 512
    },
    "format": {
      "const": "probe-protocol"
    },
    "version": {
      "const": 1
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 256
          },
          "offset": {
            "type": [
              "integer",
              "string"
            ],
            "minimum": 0,
            "maximum": 1048576,
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "length": {
            "type": [
              "integer",
              "string"
            ],
            "minimum": 0,
            "maximum": 1048576,
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "kind": {
            "enum": [
              "Hex",
              "Text",
              "Unsigned LE",
              "Unsigned BE",
              "Signed LE",
              "Signed BE",
              "Float LE",
              "Float BE",
              "Length ASCII",
              "Length LE",
              "Length BE",
              "Checksum"
            ]
          },
          "start": {
            "type": [
              "integer",
              "string"
            ],
            "minimum": 0,
            "maximum": 1048576,
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "end": {
            "type": [
              "integer",
              "string"
            ],
            "minimum": 0,
            "maximum": 1048576,
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "algorithm": {
            "enum": [
              "SUM8",
              "XOR8",
              "LRC8",
              "CRC16 Modbus",
              "CRC16 CCITT",
              "CRC32"
            ]
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 128
    }
  },
  "required": [
    "format",
    "version",
    "fields"
  ],
  "additionalProperties": false
}
